# Required — Pinecone vector database (hosted embeddings)
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX=living-atlas-docs-hosted

# Required — DeepSeek generation API
DEEPSEEK_API=sk-your_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional — base URL of the Living Atlas backend. Used to fetch live card data
# (/cards/summary) and the live Atlas fact block (/atlas/summary): counts, the
# card category and tag vocabulary, and the ArcGIS folder inventory. These
# numbers are deliberately absent from the user manual, so when this is unset the chatbot
# still works but cannot answer "how many" or "which categories" questions.
# ATLAS_API_URL=https://cereo-backend.onrender.com

# Optional — comma-separated CORS origins (defaults allow the Living Atlas
# frontend on Netlify and localhost:3000)
# ALLOWED_ORIGINS=http://localhost:3000,https://example.netlify.app

# Optional — port for local run (default 8001)
# PORT=8001

# Required for published-manual sync (same HTTPS app origin used by app workflow)
# MANUAL_BASE_URL=https://rwc-living-atlas.netlify.app
# Optional existing integrated index host (avoids index-name discovery)
# PINECONE_INDEX_HOST=https://your-index-host.svc.region.pinecone.io

# Optional — separate server-side OpenAI-compatible image understanding
# VISION_API_KEY=your_vision_provider_key
# VISION_MODEL=gpt-4.1-mini
# VISION_BASE_URL=https://api.openai.com/v1
