# Required — Pinecone vector database (hosted embeddings)
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX=living-atlas-docs-hosted

# Required — DeepSeek generation API
DEEPSEEK_API=sk-your_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional — base URL of the Living Atlas backend, used to fetch live card
# data from its /cards/summary endpoint. When unset, the chatbot still works
# but cannot answer questions about the cards currently in the database.
# ATLAS_API_URL=https://cereo-backend.onrender.com

# Optional — comma-separated CORS origins (defaults allow the Living Atlas
# frontend on Netlify and localhost:3000)
# ALLOWED_ORIGINS=http://localhost:3000,https://example.netlify.app

# Optional — port for local run (default 8001)
# PORT=8001
